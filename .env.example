# Template for a future React/Vite build; the current static app uses supabase-config.js.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key

# Never put SUPABASE_SERVICE_ROLE_KEY or any server secret in frontend code or this file.
# Supabase Edge Functions use server-side environment variables configured by Supabase.
